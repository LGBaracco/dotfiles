#!/usr/bin/env bash
# jp-tmux — tmux inside the HPC Apptainer image (passthrough / same tmux.conf).
set -euo pipefail

HPC_ENV="${HPC_ENV:-${PROJECT:+$PROJECT/hpc-env}}"
if [[ -z "${HPC_ENV:-}" ]]; then
  echo "jp-tmux: set HPC_ENV or PROJECT (expected \$PROJECT/hpc-env)" >&2
  exit 1
fi

SIF="${HPC_SIF:-$HPC_ENV/nvim-hpc.sif}"
if [[ ! -f "$SIF" ]]; then
  echo "jp-tmux: missing image $SIF (run hpc-sync image)" >&2
  exit 1
fi

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HPC_ENV/config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-${SCRATCH:-$HPC_ENV}/cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HPC_ENV/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HPC_ENV/state}"
export UV_TOOL_DIR="${UV_TOOL_DIR:-$HPC_ENV/uv-tools}"
export UV_CACHE_DIR="${UV_CACHE_DIR:-${SCRATCH:-$HPC_ENV}/uv-cache}"
export UV_TOOL_BIN_DIR="${UV_TOOL_BIN_DIR:-$HPC_ENV/uv-tools/bin}"
mkdir -p "$UV_TOOL_DIR" "$UV_CACHE_DIR" "$UV_TOOL_BIN_DIR" \
  "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME"

BINDPATH="${APPTAINER_BINDPATH:-}"
append_bind() {
  local p="$1"
  [[ -n "$p" && -e "$p" ]] || return 0
  if [[ -n "$BINDPATH" ]]; then
    BINDPATH="$BINDPATH,$p"
  else
    BINDPATH="$p"
  fi
}
append_bind "${HOME:-}"
append_bind "${PROJECT:-}"
append_bind "${SCRATCH:-}"
append_bind "${WORK:-}"
append_bind "$HPC_ENV"
export APPTAINER_BINDPATH="$BINDPATH"
export SINGULARITY_BINDPATH="$BINDPATH"

APPTAINER=(apptainer)
if ! command -v apptainer >/dev/null 2>&1; then
  if command -v singularity >/dev/null 2>&1; then
    APPTAINER=(singularity)
  else
    echo "jp-tmux: load Apptainer/Singularity module first" >&2
    exit 1
  fi
fi

EXTRA=()
if [[ "${HPC_NV:-0}" == "1" ]]; then
  EXTRA+=(--nv)
fi

# Default: attach-or-create session "main". Pass through extra tmux args if given.
if [[ $# -eq 0 ]]; then
  set -- new-session -A -s main
fi

exec "${APPTAINER[@]}" exec "${EXTRA[@]}" \
  --cleanenv \
  --env "PATH=/bin:${UV_TOOL_BIN_DIR}" \
  --env "HOME=${HOME:-/}" \
  --env "TERM=${TERM:-xterm-256color}" \
  --env "TERM_PROGRAM=${TERM_PROGRAM:-}" \
  --env "COLORTERM=${COLORTERM:-}" \
  --env "XDG_CONFIG_HOME=$XDG_CONFIG_HOME" \
  --env "XDG_CACHE_HOME=$XDG_CACHE_HOME" \
  --env "XDG_DATA_HOME=$XDG_DATA_HOME" \
  --env "XDG_STATE_HOME=$XDG_STATE_HOME" \
  --env "UV_TOOL_DIR=$UV_TOOL_DIR" \
  --env "UV_CACHE_DIR=$UV_CACHE_DIR" \
  --env "UV_TOOL_BIN_DIR=$UV_TOOL_BIN_DIR" \
  --env "SSL_CERT_FILE=/etc/ssl/certs/ca-bundle.crt" \
  --env "EDITOR=nvim" \
  --env "VISUAL=nvim" \
  ${PROJECT:+--env "PROJECT=$PROJECT"} \
  ${SCRATCH:+--env "SCRATCH=$SCRATCH"} \
  "$SIF" tmux "$@"
