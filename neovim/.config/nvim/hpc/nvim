#!/bin/sh
# nvim-hpc launcher (bundle built by hpc/bundle.nix). Everything Neovim reads or
# writes stays inside the extracted nvim-hpc/ folder, except its cache:
#   app/   official nvim + Quarto, plugin pack, Lua config, static tools (replaced on update)
#   var/   data/state: undo, shada, rplugin manifest, Jupyter kernel specs, logs
# NVIM_APPNAME=nvim-hpc plus one link per XDG base (<base>/nvim-hpc -> bundle) moves
# stdpath() here. The cache is a plain <cache base>/nvim-hpc dir (e.g. on $SCRATCH),
# safe to lose. Child processes (terminals, git, uv, LSPs, kernels) keep the normal
# environment, except JUPYTER_DATA_DIR and the bundled tools appended to PATH.
set -eu

self=$(readlink -f "$0")
root=${self%/bin/nvim}
app=$root/app
export NVIM_APPNAME=nvim-hpc

# link BASE TARGET: BASE/nvim-hpc -> TARGET; never replaces a real file or directory
link() {
  l=$1/$NVIM_APPNAME
  if [ -L "$l" ] || [ ! -e "$l" ]; then
    [ "$(readlink "$l" 2>/dev/null)" = "$2" ] && return
    mkdir -p "$1" "$2"
    ln -sfn "$2" "$l"
  else
    echo "nvim-hpc: $l exists and is not a symlink; move it away" >&2
    exit 1
  fi
}
link "${XDG_CONFIG_HOME:-$HOME/.config}" "$app/config"
link "${XDG_DATA_HOME:-$HOME/.local/share}" "$root/var/data"
link "${XDG_STATE_HOME:-$HOME/.local/state}" "$root/var/state"

# Earlier bundles linked the cache into var/cache; turn it back into a plain dir.
cache=${XDG_CACHE_HOME:-$HOME/.cache}/$NVIM_APPNAME
if [ "$(readlink "$cache" 2>/dev/null)" = "$root/var/cache" ]; then
  rm -f "$cache"
  rm -rf "$root/var/cache"
fi

# Molten kernel specs + connection files (plugins/repl/molten.lua jupyter_data_dir)
export JUPYTER_DATA_DIR="${JUPYTER_DATA_DIR:-$root/var/data/jupyter}"
# Like the Nix wrapper's runtimePkgs: appended, so system tools still win
export PATH="${PATH:+$PATH:}$app/tools/bin:$app/quarto/bin"

exec "$app/nvim/bin/nvim" --cmd "lua dofile([[$app/bootstrap.lua]])" "$@"
