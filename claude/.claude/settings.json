{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ask-readonly-bash.py"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/dcal-guard.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "i-have-adhd@i-have-adhd": true
  },
  "extraKnownMarketplaces": {
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {}
  },
  "awaySummaryEnabled": false,
  "theme": "custom:oxocarbon",
  "editorMode": "vim",
  "skillOverrides": {
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:google-workspace": "off"
  },
  "permissions": {
    "defaultMode": "auto"
  }
}
