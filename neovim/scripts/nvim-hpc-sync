#!/usr/bin/env bash
# nvim-hpc-sync — push the Nix-built Neovim plugin pack (module-hpc.nix) to a
# JSC cluster and install matching nvim/quarto release binaries there.
#
# Everything lands in a gitignored stow package inside the cluster's dotfiles
# repo (~/dotfiles → $PROJECT), never directly in $HOME:
#   hpc-nvim/.local/share/nvim/site/pack/nix/{start,opt}  plugins + parsers
#   hpc-nvim/.local/opt/{nvim,quarto}-<ver>/              release tarballs
#   hpc-nvim/.local/bin/{nvim,quarto}                     → ../opt/<name>-<ver>
# One-time on the cluster: cd ~/dotfiles && stow hpc-nvim
# (site/ and opt/ fold into single links, so later syncs need no restow), and
# ln -sfn ~/dotfiles/neovim/.config/nvim ~/.config/nvim (or stow neovim).
#
# After editing module-hpc.nix, refresh the pinned path input first:
#   nix flake update nvim-config --flake ~/dotfiles/nixos/nixos
#
# Env:
#   HPC_HOST      SSH destination (default baracco1@jureca.fz-juelich.de)
#   HPC_DOTFILES  dotfiles repo on the cluster, relative to its $HOME (default dotfiles)
#   HPC_SSH_OPTS  extra ssh options (default: IPv4 + ~/.ssh/id_jureca if present)
#   FLAKE         local nixos flake dir (default ~/dotfiles/nixos/nixos)
set -euo pipefail

HPC_HOST="${HPC_HOST:-baracco1@jureca.fz-juelich.de}"
HPC_DOTFILES="${HPC_DOTFILES:-dotfiles}"
FLAKE="${FLAKE:-$HOME/dotfiles/nixos/nixos}"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/nvim-hpc-sync"
pkg="$HPC_DOTFILES/hpc-nvim"

# Same login as the `mju` sshfs alias; one SSH connection for all steps.
if [[ -n "${HPC_SSH_OPTS:-}" ]]; then
  read -ra ssh_opts <<<"$HPC_SSH_OPTS"
else
  ssh_opts=(-o AddressFamily=inet)
  [[ -f "$HOME/.ssh/id_jureca" ]] && ssh_opts+=(-o "IdentityFile=$HOME/.ssh/id_jureca")
fi
ssh_opts+=(-o ControlMaster=auto -o "ControlPath=${XDG_RUNTIME_DIR:-/tmp}/nvim-hpc-sync-%C" -o ControlPersist=60)
# shellcheck disable=SC2029 # local expansion into remote commands is intended
remote() { ssh "${ssh_opts[@]}" "$HPC_HOST" "$@"; }
rsync_to() { rsync -e "ssh ${ssh_opts[*]}" "$@"; }

rc=0
remote "test -e '$HPC_DOTFILES/.git' || exit 3" || rc=$?
case $rc in
0) ;;
3)
  echo "nvim-hpc-sync: no git repo at ~/$HPC_DOTFILES on $HPC_HOST (set HPC_DOTFILES)" >&2
  exit 1
  ;;
*)
  echo "nvim-hpc-sync: ssh to $HPC_HOST failed (exit $rc); see HPC_SSH_OPTS" >&2
  exit 1
  ;;
esac

echo "Building $FLAKE#nvim-hpc"
out=$(nix build --no-link --print-out-paths "$FLAKE#nvim-hpc")
nvim_ver=$("$out/bin/nvim" --version | awk 'NR == 1 { print $2 }') # e.g. v0.12.5
quarto_ver=$(nix eval --raw "$FLAKE#quarto.version")                 # e.g. 1.10.18

remote "mkdir -p '$pkg/.local/share/nvim/site/pack/nix' '$pkg/.local/opt' '$pkg/.local/bin'"

echo "Syncing plugin pack → $HPC_HOST:$pkg"
rsync_to -rL --delete --chmod=Du+w,Fu+w --info=stats1 --exclude nix-info \
  "$out/nvim-packdir/pack/myNeovimPackages/" \
  "$HPC_HOST:$pkg/.local/share/nvim/site/pack/nix/"

# install_release NAME VERSION URL TOPDIR: unpack URL (tar.gz whose root is
# TOPDIR) into $pkg/.local/opt/NAME-VERSION, point $pkg/.local/bin/NAME at it
# and drop other versions. Downloads on the cluster; falls back to downloading
# here and copying over.
install_release() {
  local name=$1 ver=$2 url=$3 top=$4
  local opt="$pkg/.local/opt" file=${url##*/}
  local unpack="set -eo pipefail; d=\$(mktemp -d '$opt/.tmp.XXXXXX'); trap 'rm -rf \"\$d\"' EXIT"

  if remote "test -x '$opt/$name-$ver/bin/$name'"; then
    echo "$name $ver already installed"
  else
    echo "Installing $name $ver on $HPC_HOST"
    if ! remote "$unpack; curl -fsSL '$url' | tar -xz -C \"\$d\"; mv \"\$d/$top\" '$opt/$name-$ver'"; then
      echo "Download on $HPC_HOST failed; fetching locally and copying"
      mkdir -p "$CACHE"
      [[ -s "$CACHE/$file" ]] || curl -fL "$url" -o "$CACHE/$file"
      rsync_to "$CACHE/$file" "$HPC_HOST:$opt/"
      remote "$unpack; tar -xzf '$opt/$file' -C \"\$d\"; mv \"\$d/$top\" '$opt/$name-$ver'; rm -f '$opt/$file'"
    fi
  fi
  remote "ln -sfn '../opt/$name-$ver/bin/$name' '$pkg/.local/bin/$name' &&
    find '$opt' -mindepth 1 -maxdepth 1 -name '$name-*' ! -name '$name-$ver' -exec rm -rf {} +"
}

install_release nvim "$nvim_ver" \
  "https://github.com/neovim/neovim/releases/download/$nvim_ver/nvim-linux-x86_64.tar.gz" \
  nvim-linux-x86_64
install_release quarto "$quarto_ver" \
  "https://github.com/quarto-dev/quarto-cli/releases/download/v$quarto_ver/quarto-$quarto_ver-linux-amd64.tar.gz" \
  "quarto-$quarto_ver"

remote "du -sh '$pkg'/.local/share/nvim/site/pack/nix '$pkg'/.local/opt/*" || true
cat <<EOF

Done. One-time on $HPC_HOST (later syncs need no restow):
  cd ~/$HPC_DOTFILES && stow hpc-nvim
  ln -sfn ~/$HPC_DOTFILES/neovim/.config/nvim ~/.config/nvim
EOF
