niri/.config/niri/dms/outputs.kdl
niri/.config/niri/cfg/display.kdl
niri/.config/niri/dms/cursor.kd
DankMaterialShell/.config/DankMaterialShell/monitors.json
onedrive-sync/.config/rclone/rclone.conf
neovim/AGENTS.md

# claude: ~/.claude lives here via stow, but only config is tracked
# Whitelist: settings / keybindings / CLAUDE.md / agents / hooks / themes / skills/ask
# Everything else (secrets + runtime) stays local and untracked.
claude/.claude/*
!claude/.claude/settings.json
!claude/.claude/keybindings.json
!claude/.claude/CLAUDE.md
!claude/.claude/agents/
!claude/.claude/hooks/
!claude/.claude/themes/
!claude/.claude/skills/
claude/.claude/skills/*
!claude/.claude/skills/ask/

# Explicit denylist — belt-and-suspenders if the whitelist is loosened later
claude/.claude/settings.local.json
claude/.claude/.credentials.json
claude/.claude/history.jsonl
claude/.claude/backups/
claude/.claude/cache/
claude/.claude/debug/
claude/.claude/file-history/
claude/.claude/projects/
claude/.claude/session-env/
claude/.claude/sessions/
claude/.claude/shell-snapshots/
claude/.claude/statsig/
claude/.claude/todos/
claude/.claude/transcripts/

# fish/ghostty: runtime state written next to stowed configs
fish/.config/fish/fish_variables
ghostty/.config/ghostty/themes/
