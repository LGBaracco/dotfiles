#!/usr/bin/env bash
# nvim-hpc-sync — build the self-contained HPC Neovim bundle (flake output
# nvim-hpc-bundle, neovim/.config/nvim/hpc/bundle.nix) and install it on a JSC
# cluster as <prefix>/nvim-hpc. Updates replace app/ and bin/; var/ (undo, shada,
# rplugin manifest, kernel specs) is kept. ~/.local/bin/nvim is linked to the
# launcher unless a real file is already there.
#
# Lua edits need no extra step: the bundle is built from the local config tree
# (--override-input), so flake.lock is never touched.
#
# Manual install instead: nix build ~/dotfiles/nixos/nixos#nvim-hpc-bundle, copy
# result/nvim-hpc.tar.gz to <prefix>, then in <prefix>:
#   rm -rf nvim-hpc/app nvim-hpc/bin && tar -xzf nvim-hpc.tar.gz
#
# Env:
#   HPC_HOST      SSH destination (default baracco1@jureca.fz-juelich.de)
#   HPC_PREFIX    install folder on the cluster (default: the folder ~/.local
#                 really lives in, i.e. next to the dotdirs in $PROJECT)
#   HPC_SSH_OPTS  extra ssh options (default: IPv4 + ~/.ssh/id_jureca if present)
#   FLAKE         local nixos flake dir (default ~/dotfiles/nixos/nixos)
#   NVIM_CONFIG   local Lua config built into the bundle (default ~/dotfiles/neovim/.config/nvim)
set -euo pipefail

HPC_HOST="${HPC_HOST:-baracco1@jureca.fz-juelich.de}"
FLAKE="${FLAKE:-$HOME/dotfiles/nixos/nixos}"
NVIM_CONFIG="${NVIM_CONFIG:-$HOME/dotfiles/neovim/.config/nvim}"

# Same login as the `mju` sshfs alias; one SSH connection for all steps.
if [[ -n "${HPC_SSH_OPTS:-}" ]]; then
  read -ra ssh_opts <<<"$HPC_SSH_OPTS"
else
  ssh_opts=(-o AddressFamily=inet)
  [[ -f "$HOME/.ssh/id_jureca" ]] && ssh_opts+=(-o "IdentityFile=$HOME/.ssh/id_jureca")
fi
ssh_opts+=(-o ControlMaster=auto -o "ControlPath=${XDG_RUNTIME_DIR:-/tmp}/nvim-hpc-sync-%C" -o ControlPersist=60)
# shellcheck disable=SC2029 # local expansion into remote commands is intended
remote() { ssh "${ssh_opts[@]}" "$HPC_HOST" "$@"; }
rsync_to() { rsync -e "ssh ${ssh_opts[*]}" "$@"; }

echo "Building $FLAKE#nvim-hpc-bundle"
out=$(nix build --no-link --print-out-paths --no-write-lock-file \
  --override-input nvim-config "path:$NVIM_CONFIG" "$FLAKE#nvim-hpc-bundle")
cat "$out/VERSION"

# Default: next to the dotdirs, i.e. the folder ~/.local really lives in. Refuses
# a prefix inside the real $HOME (realpath -e: a missing path must not resolve).
# shellcheck disable=SC2016 # expands on the cluster
if [[ -n "${HPC_PREFIX:-}" ]]; then
  prefix=$HPC_PREFIX
elif ! prefix=$(remote 'h=$(realpath -e ~) && d=$(realpath -e ~/.local) && p=${d%/*} &&
  case $p/ in "$h"/*) exit 1 ;; esac && echo "$p"'); then
  echo "nvim-hpc-sync: no install folder outside \$HOME on $HPC_HOST (ssh failed, or ~/.local is not linked into \$PROJECT); set HPC_PREFIX" >&2
  exit 1
fi
dest="$prefix/nvim-hpc"

# The previous tarball stays at $dest/bundle.tar.gz, so rsync (and gzip
# --rsyncable) only transfers what changed.
echo "Uploading → $HPC_HOST:$dest"
remote "mkdir -p '$dest'"
rsync_to --partial --info=progress2 "$out/nvim-hpc.tar.gz" "$HPC_HOST:$dest/bundle.tar.gz"

remote "set -e
  cd '$dest'
  tmp=\$(mktemp -d .new.XXXXXX)
  trap 'rm -rf \"\$tmp\"' EXIT
  tar -xzf bundle.tar.gz -C \"\$tmp\"
  rm -rf app bin
  mv \"\$tmp/nvim-hpc/app\" \"\$tmp/nvim-hpc/bin\" .
  l=\$HOME/.local/bin/nvim
  if [ -L \"\$l\" ] || [ ! -e \"\$l\" ]; then
    mkdir -p \"\${l%/*}\" && ln -sfn '$dest/bin/nvim' \"\$l\"
  else
    echo \"note: \$l is a real file, not linking $dest/bin/nvim\"
  fi
  du -sh app"

echo "Installed $dest (restart running nvim sessions)."
