#!/usr/bin/env bash
# Jupyter server for Emacs (lisp/+jupyter-remote.el), started over ssh / sbatch.
#   start-server [--port N] [--ip ADDR] [--token-file F] [--root DIR] [--kernel NAME]
# Defaults as the `start-server' alias in ~/.bashrc (which still wins when typed in
# an interactive shell; Emacs calls this file by path): 0.0.0.0:8888, default
# kernel atlas. --token-file reads the token from a 0600 file (never in `ps').

# ~/.bashrc returns early for non-interactive shells, so set up the same
# environment here: modules (uv), $PROJECT, XDG dirs on home_ext (where the
# atlas kernelspec lives), caches on $SCRATCH. Keep in sync with ~/.bashrc.
# shellcheck source=/dev/null
type module >/dev/null 2>&1 || { [ -r /etc/profile ] && . /etc/profile >/dev/null 2>&1; }
command -v jutil >/dev/null 2>&1 && jutil env activate -p cjinm16 >/dev/null
if [ -d "${PROJECT:-}/home_ext" ]; then
    export HOME_EXT=$PROJECT/home_ext
    export XDG_CONFIG_HOME=$HOME_EXT/.config
    export XDG_DATA_HOME=$HOME_EXT/.local/share
    export XDG_STATE_HOME=$HOME_EXT/.local/state
fi
if [ -d "${SCRATCH:-}/$USER" ]; then
    export XDG_CACHE_HOME=$SCRATCH/$USER/.cache
    export APPTAINER_CACHEDIR=$XDG_CACHE_HOME/apptainer
fi
type module >/dev/null 2>&1 && module try-load uv

set -eo pipefail

port=8888 ip=0.0.0.0 token_file='' root='' kernel=atlas
while [ $# -gt 0 ]; do
    case $1 in
    --port) port=$2; shift 2 ;;
    --ip) ip=$2; shift 2 ;;
    --token-file) token_file=$2; shift 2 ;;
    --root) root=$2; shift 2 ;;
    --kernel) kernel=$2; shift 2 ;;
    -h | --help) sed -n '2,6p' "$0"; exit 0 ;;
    *) echo "start-server: unknown option $1" >&2; exit 2 ;;
    esac
done

if [ -n "$token_file" ]; then
    JUPYTER_TOKEN=$(cat "$token_file")
    export JUPYTER_TOKEN
fi
args=(--no-browser --ip="$ip" --port="$port" --ServerApp.port_retries=0
    --MappingKernelManager.default_kernel_name="$kernel")
[ -n "$root" ] && args+=(--ServerApp.root_dir="$root")

# PYTHONPATH from modules shadows the uv env's packages and breaks on its newer
# Python. --no-project: a pyproject.toml in the cwd must not become the server env.
exec env -u PYTHONPATH uv run --no-project --with jupyter jupyter server "${args[@]}"
