{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ask-readonly-bash.py"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "awaySummaryEnabled": false,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "enabledPlugins": {
    "i-have-adhd@i-have-adhd": true
  }
}
