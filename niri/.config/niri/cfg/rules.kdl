    window-rule {
        geometry-corner-radius 15 // Set every window radius to 15
        clip-to-geometry true
        draw-border-with-background false
        // opacity 0.96
    //     background-effect {
    //         blur true
    //         xray false
    //         
    // }
    }

//     blur {
//   passes 5        // more passes = stronger blur (default: 3)
//   offset 3.0      // sample distance per pass (default: 3.0)
//   noise 0.03      // grain overlay (default: 0.02)
//   saturation 1.0  // color saturation boost (default: 1.5)
// }

    window-rule {
        match app-id="brave-browser"
        match app-id="code" 
        match app-id="emacs"
        match app-id="thunderbird"
        match app-id="obsidian"
        match app-id="Zotero"
        open-maximized true
    }

    window-rule {
        match app-id="steam"
        exclude title=r#"^[Ss]team$"#
        open-floating true
    }
    window-rule {
       match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
       default-floating-position x=10 y=10 relative-to="bottom-right"
       open-focused false
    }

