{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ask-readonly-bash.py"
          }
        ]
      }
    ]
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "awaySummaryEnabled": false,
  "theme": "dark-ansi",
  "editorMode": "vim"
}
