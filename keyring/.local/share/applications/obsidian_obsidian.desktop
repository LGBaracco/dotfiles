[Desktop Entry]
X-SnapInstanceName=obsidian
Name=Obsidian
X-SnapAppName=obsidian
Exec=/snap/bin/obsidian --password-store=gnome-libsecret %U
Terminal=false
Type=Application
Icon=/snap/obsidian/current/meta/gui/icon.png
StartupWMClass=md.obsidian.Obsidian
Comment=Obsidian
MimeType=application/pdf;text/markdown;application/x-obsidian-canvas;application/x-obsidian-base;x-scheme-handler/obsidian;
Categories=Office;

